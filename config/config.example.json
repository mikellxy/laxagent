{
  "recursion_limit": -1,
  "cancel_timeout_seconds": 30,
  "web_search": {
    "api_key": "replace-with-web-search-api-key",
    "timeout_seconds": 30
  },
  "llm": {
    "default_model": "example:model-name",
    "provider_list": [
      {
        "name": "example",
        "base_url": "https://provider.example.com/v1",
        "api_key": "replace-with-real-key",
        "model_list": [
          {
            "name": "model-name",
            "supports_multimodal": false,
            "limit": {
              "context": 128000,
              "output": 16000
            }
          }
        ]
      }
    ]
  },
  "api_server": {
    "port": 8000
  },
  "llm_router": {
    "port": 8001
  },
  "frontend": {
    "dist_dir": "../frontend/dist"
  },
  "nats": {
    "url": "nats://127.0.0.1:4222"
  },
  "database": {
    "host": "127.0.0.1",
    "port": 5432,
    "name": "laxcode",
    "user": "laxcode",
    "password": "replace-with-local-password"
  },
  "auth": {
    "jwt_secret": "replace-with-random-secret-at-least-32-bytes"
  }
}
